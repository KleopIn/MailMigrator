<Window x:Class="MailMigrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mail Migrator"
        Width="960" Height="940" MinWidth="780" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}" FontFamily="Segoe UI" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22">

            <!-- ===== ШАПКА ===== -->
            <Border CornerRadius="6" Margin="0,0,0,14">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1E3A8A" Offset="0"/>
                        <GradientStop Color="#2563EB" Offset="0.55"/>
                        <GradientStop Color="#1D4ED8" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="6" Color="#000000" Opacity="0.5"/>
                </Border.Effect>
                <Grid Margin="20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="MAIL MIGRATOR" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Перенос почты между IMAP-серверами · mail.ru → Exchange" FontSize="13"
                                   Foreground="#BFD3F5" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="📧" FontSize="30" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ===== СПРАВКА ===== -->
            <Border Background="#12244A" BorderBrush="#2A4B8D" BorderThickness="1" CornerRadius="5" Padding="14,12" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="КАК ПОЛЬЗОВАТЬСЯ" FontWeight="SemiBold" Foreground="#7FA8FF" Margin="0,0,0,5" FontSize="11"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#B9CCF0" LineHeight="20" FontSize="13"
                               Text="1. Источник (mail.ru): логин = полный e-mail, пароль = пароль приложения (не основной пароль).&#10;2. Назначение (Exchange): логин = доменная учётка, пароль = доменный пароль.&#10;3. При необходимости задайте период «с…по…» и нажмите «▶ Запустить миграцию».&#10;Пароли шифруются (DPAPI) и хранятся только на этом компьютере."/>
                </StackPanel>
            </Border>

            <!-- ===== ИСТОЧНИК + НАЗНАЧЕНИЕ ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Источник -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ИСТОЧНИК · MAIL.RU" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Хост (IMAP)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SourceHostBox" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Порт" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SourcePortBox" Grid.Row="1" Grid.Column="1" Text="993" Width="90" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Логин (e-mail)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="SourceUserBox" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Пароль приложения" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="SourcePassBox" Grid.Row="3" Grid.Column="1"/>

                            <CheckBox x:Name="SourceSslCheck" Grid.Row="4" Grid.Column="1" Content="Использовать SSL/TLS"
                                      IsChecked="True" VerticalAlignment="Center" Margin="0,2,0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Назначение -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="НАЗНАЧЕНИЕ · EXCHANGE" Style="{StaticResource SectionTitle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Хост (IMAP)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DestHostBox" Grid.Row="0" Grid.Column="1"/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Порт" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DestPortBox" Grid.Row="1" Grid.Column="1" Text="993" Width="90" HorizontalAlignment="Left"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Логин (e-mail)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="DestUserBox" Grid.Row="2" Grid.Column="1"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Пароль" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="DestPassBox" Grid.Row="3" Grid.Column="1"/>

                            <CheckBox x:Name="DestSslCheck" Grid.Row="4" Grid.Column="1" Content="Использовать SSL/TLS"
                                      IsChecked="True" VerticalAlignment="Center" Margin="0,2,0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== ПАРАМЕТРЫ ===== -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="ПАРАМЕТРЫ ПЕРЕНОСА" Style="{StaticResource SectionTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Папки" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox x:Name="InboxCheck" Content="Входящие (INBOX)" IsChecked="True" Margin="0,0,20,0"/>
                            <CheckBox x:Name="SentCheck" Content="Отправленные (Sent)" IsChecked="True"/>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Период (необязательно)" Style="{StaticResource FieldLabel}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="с" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <DatePicker x:Name="DateFromPicker" Width="140"/>
                            <TextBlock Text="по" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                            <DatePicker x:Name="DateToPicker" Width="140"/>
                        </StackPanel>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Макс. размер письма (МБ)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MaxBytesBox" Grid.Row="2" Grid.Column="1" Text="18" Width="90" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Задержка между письмами (мс)" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="RateDelayBox" Grid.Row="3" Grid.Column="1" Text="120" Width="90" HorizontalAlignment="Left"/>

                        <CheckBox x:Name="DateBoundaryCheck" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                  Content="Пропускать письма новее самого старого в целевом INBOX (защита от повторов)"
                                  IsChecked="True" Margin="0,2,0,2"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ===== КНОПКИ ===== -->
            <WrapPanel Margin="0,0,0,14">
                <Button x:Name="StartBtn" Content="▶  Запустить миграцию" Click="Start_Click" Style="{StaticResource PrimaryButton}"/>
                <Button x:Name="CancelBtn" Content="Отмена" Click="Cancel_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0" IsEnabled="False"/>
                <Button x:Name="SaveBtn" Content="Сохранить профиль" Click="Save_Click" Style="{StaticResource GhostButton}" Margin="24,0,0,0"/>
                <Button x:Name="LoadBtn" Content="Загрузить профиль" Click="Load_Click" Style="{StaticResource GhostButton}" Margin="8,0,0,0"/>
            </WrapPanel>

            <!-- ===== ПРОГРЕСС ===== -->
            <ProgressBar x:Name="ProgressBar1" Margin="0,0,0,10"/>
            <TextBlock x:Name="StatusText" Text="Готов к работе." Foreground="{StaticResource TextPrimary}" Margin="0,0,0,4"/>
            <TextBlock x:Name="CountersText" Text="Перенесено: 0   Ошибок: 0   Уже есть: 0   Крупные (&gt;18 МБ): 0   Вне периода: 0"
                       Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

            <!-- ===== ЖУРНАЛ ===== -->
            <TextBlock Text="ЖУРНАЛ" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4" FontSize="11"/>
            <TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Height="210"
                     AcceptsReturn="True" Margin="0"/>

        </StackPanel>
    </ScrollViewer>
</Window>
